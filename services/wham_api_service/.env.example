# WHAM API Service Environment Configuration
# Copy this file to .env and customize for your environment
# Or set these as OS environment variables (OS env takes precedence over .env)

# Data directory root (videos, dataset, checkpoints, output folders expected here)
# Default: /mnt/e/Code/IT4788/WHAM/WHAM_data
# Example for alternative workspace:
WHAM_DATA_DIR=/mnt/e/Code/IT4788/WHAM/WHAM_data

# Repository root directory (where demo.py, train.py, scripts/ live)
# Default: /mnt/e/Code/IT4788/WHAM/WHAM
# Example for alternative workspace:
WHAM_REPO_DIR=/mnt/e/Code/IT4788/WHAM/WHAM

# Docker image name
# Default: wham-local
WHAM_DOCKER_IMAGE=wham-local

# PostgreSQL connection string for job persistence
# Example: postgresql+psycopg://wham:wham@localhost:5432/wham
WHAM_DATABASE_URL=

# Auth headers for server-to-server API key authentication
WHAM_AUTH_SUBJECT_HEADER=X-WHAM-Subject
WHAM_AUTH_API_KEY_HEADER=X-WHAM-Api-Key

# Optional bootstrap API keys on startup in CSV format: subject:key,subject2:key2
# WHAM_BOOTSTRAP_API_KEYS=service-a:key-1,service-b:key-2
WHAM_BOOTSTRAP_API_KEYS=

# Optional JSON file to bootstrap API keys. Supports either:
# {"subjects": {"service-a": ["key-1"]}} or
# {"api_keys": [{"subject": "service-a", "api_key": "key-1", "enabled": true}]}
WHAM_BOOTSTRAP_API_KEYS_FILE=

# Default GPU device ID (0, 1, 2, etc.)
# Default: 0
WHAM_GPU_ID=0

# Server-owned execution defaults
WHAM_POSE2D_VISUALIZE=true
WHAM_POSE2D_ESTIMATE_LOCAL_ONLY=false
WHAM_POSE3D_VISUALIZE=true
WHAM_POSE3D_ESTIMATE_LOCAL_ONLY=false
WHAM_POSE3D_SAVE_PKL=true
WHAM_POSE3D_RUN_SMPLIFY=false
WHAM_DOCKER_CLEANUP_ENABLED=true
