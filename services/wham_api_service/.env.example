# WHAM API Service Environment Configuration
# Copy this file to .env and customize for your environment
# Or set these as OS environment variables (OS env takes precedence over .env)

# Data directory root (videos, dataset, checkpoints, output folders expected here)
# Default: /mnt/e/Code/IT4788/WHAM/WHAM_data
# Example for alternative workspace:
WHAM_DATA_DIR=/mnt/e/Code/IT4788/WHAM/WHAM_data

# Repository root directory (where demo.py, train.py, scripts/ live)
# Default: /mnt/e/Code/IT4788/WHAM/WHAM
# Example for alternative workspace:
WHAM_REPO_DIR=/mnt/e/Code/IT4788/WHAM/WHAM

# Docker image name
# Default: wham-local
WHAM_DOCKER_IMAGE=wham-local

# Default GPU device ID (0, 1, 2, etc.)
# Default: 0
WHAM_GPU_ID=0
